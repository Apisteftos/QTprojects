# ---------------------------------------------------------------
# .gitignore for the Qt tutorial (Qt Creator, CMake, Qt Design Studio)
# Rule: commit project source and configuration files only,
# never user settings, build output or generated files.
# ---------------------------------------------------------------

# --- Build folders (Qt Creator names them build/..., build-...-Debug, ...-Debug)
build/
build-*/
*-build-*/
cmake-build-*/
*-Debug/
*-Release/
*-RelWithDebInfo/
*-MinSizeRel/
Debug/
Release/
.qtc/
.qtcreator/
.qtcreator.*
.cache/
.clangd
.qtc_clangd/

# --- CMake generated files
CMakeLists.txt.user
CMakeLists.txt.user*
CMakeUserPresets.json
CMakeCache.txt
CMakeFiles/
CMakeScripts/
/Testing/
cmake_install.cmake
install_manifest.txt
CTestTestfile.cmake
_deps/
compile_commands.json
target_wrapper.*

# --- Qt generated files
*_plugin_import.cpp
*_qmlcache.qrc
.qmake.cache
.qmake.stash
object_script.*.Release
object_script.*.Debug
*.moc
moc_*.cpp
moc_*.h
qrc_*.cpp
ui_*.h
*.qmlc
*.jsc
*.qm
*.prl
*.qmlls.ini
Makefile*

# --- Qt Creator and Qt Design Studio user settings (contain absolute paths)
*.user
*.user.*
*.pro.user*
*.qbs.user
*.qbs.user.*
*.qmlproject.user
*.qmlproject.user.*
*.qmlproject.qtds
*.qtds
*creator.user*
*.autosave

# --- Compiler output
*.slo
*.lo
*.o
*.obj
*.a
*.la
*.lai
*.so
*.so.*
*.dll
*.dylib
*.exe
*.app
*.debug
*.Debug
*.Release
*.pdb
*.ilk
*.idb
*.pch
*_pch.h.cpp

# --- Core dump files (only at the top of the repo, so a folder named "core" is kept)
/core
core.[0-9]*

# --- Visual Studio leftovers
*.sln
*.suo
*.vcproj
*.vcxproj
*.vcxproj.*
*vcproj.*.*.user
*.sdf
*.opensdf
*.ncb
*.ib_pdb_index

# --- Editors, system files, merge leftovers
.vscode/
.idea/
.DS_Store
Thumbs.db
.directory
*.swp
.*.swp
*~
*.*#
.#*
*.orig
*.rej
tags

# --- Files that Qt Design Studio can generate.
# Qt's documentation says not to store generated files, but the exact
# list depends on the project and the Design Studio version. Check what
# your project creates, then remove the leading "#" of the lines you
# want to ignore:
# insight/
# qmlcomponents/
# qmlmodules/
# src/import_qml_plugins.h
